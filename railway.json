{
  "deploy": {
    "preDeployCommand": "python manage.py migrate --noinput && python manage.py seed_neet",
    "startCommand": "python manage.py collectstatic --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 2 --timeout 180",
    "healthcheckPath": "/health/",
    "healthcheckTimeout": 180
  }
}
