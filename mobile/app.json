{
  "expo": {
    "name": "OJAS ONE Question Builder",
    "slug": "ojas-question-builder-native",
    "version": "1.4.3",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.ojasone.questionbuilder.nativeapp",
      "versionCode": 12,
      "permissions": [
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose your academy logo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://questionpaper-selling-project-production.up.railway.app/api/mobile/v1/"
    },
    "icon": "./assets/icon.png"
  }
}
